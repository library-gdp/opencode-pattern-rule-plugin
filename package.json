{
  "name": "opencode-conditional-instructions",
  "version": "0.0.0",
  "description": "OpenCode plugin that injects path-based conditional instructions",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:bundle": "node scripts/opencode-install.mjs build",
    "opencode:install": "node scripts/opencode-install.mjs install",
    "opencode:uninstall": "node scripts/opencode-install.mjs uninstall",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.19.5"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.19.5",
    "@types/node": "^24.19.2",
    "@types/picomatch": "^4.0.3",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "^0.28.2",
    "testcontainers": "^12.2.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "picomatch": "^4.0.7",
    "yaml": "^2.9.1"
  }
}
